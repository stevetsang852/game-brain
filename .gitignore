# --- Never commit copyrighted game data ---
# Private repo does not make a commercial ROM legal to commit.
*.gba
*.gbc
*.gb
*.agb
*.zip
*.7z
*.sav
*.srm
*.ss[0-9]
*.ss*
*.state
roms/
saves/
bios/
*.bin
.game-brain/
*.tmp

# Large model weights stay local. Small experiment summaries may be committed.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.pkl
*.npz

# ROM-derived screenshots and raw archives stay local.
runs/
*.png
*.mp4
*.sqlite3*
*.sqlite
*.db
*.db-wal
*.db-shm
archive.json

# Own RL experiment records: policy summaries and reward logs, not ROM dumps.
!experiments/
!experiments/**/*.json
!experiments/**/*.md
!experiments/**/*.jsonl

# --- Built native shim ---
game_brain/adapters/gba_mgba/_build/
*.so
*.o

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.env
